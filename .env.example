# Copy this file to .env and change the password before starting the app.
# The admin password is the only required secret — pick something long and private.
ADMIN_PASSWORD=change-me-please

# Optional. If left unset, the app generates one automatically and stores
# it in ./data/secret_key. It signs login cookies.
# SECRET_KEY=

# Optional. Enables the read-only /api/upcoming-books endpoint for the
# Household Hub. Generate a token with:  openssl rand -hex 32
# Leave unset to keep the endpoint switched off (it returns 503).
# HUB_API_TOKEN=

# Optional. Links books to your Audiobookshelf server. Set both to enable:
# ABS_URL is where THIS app reaches Audiobookshelf; ABS_TOKEN is your API
# token (Audiobookshelf -> Settings -> Users -> your user -> API Token).
# ABS_URL=http://books.ericlemmons.com:13378
# ABS_TOKEN=

# Optional. Public link base if it differs from ABS_URL (defaults to ABS_URL).
# ABS_PUBLIC_URL=

# Optional. Deep-links into your listening app: with this set, "Listen"
# links try the app first and fall back to the web player automatically.
# {id} becomes the Audiobookshelf item id. For AudioBooth on iOS use:
#   audiobooth://open/{id}   (opens the book)
#   audiobooth://play/{id}   (starts playing it immediately)
# ABS_APP_LINK_TEMPLATE=audiobooth://open/{id}
